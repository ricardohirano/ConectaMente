<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="pagina-sobre-jogo">
  <section class="sobre-jogo-topo">
    <div class="container">
      <h1 class="titulo-sobre-jogo">Sobre o jogo</h1>

      <p class="texto-introducao-jogo">
        O ConectaMente: Minha Rotina Divertida é um jogo educativo
        desenvolvido para ajudar crianças a organizarem sua rotina
        diária de forma divertida e interativa.
      </p>
    </div>
  </section>

  <section class="bloco-sobre-jogo">
    <div class="icone-objetivo-topo">
      <img src="/img/website/sobre/objetivo.svg" alt="Objetivo do jogo">
    </div>

    <div class="container">
      <h2 class="subtitulo-sobre-jogo">Objetivo do jogo</h2>

      <p class="texto-objetivo-jogo">
        O objetivo do jogo é ajudar crianças a desenvolver hábitos saudáveis
        através da organização da rotina diária, incentivando responsabilidade
        e autonomia de forma lúdica.
      </p>

      <h2 class="subtitulo-como-funciona">Como funciona o jogo</h2>

      <div class="cards-como-funciona">
        <div class="card-etapa etapa-1">
          <span class="numero-etapa numero-1">1</span>
          <img src="/img/website/sobre/rotina.svg" alt="Escolha atividades">
          <h3>Escolha atividades do dia</h3>
          <p>
            A criança seleciona as atividades que precisa realizar.
          </p>
        </div>

        <div class="card-etapa etapa-2">
          <span class="numero-etapa numero-2">2</span>
          <img src="/img/website/sobre/calendario.svg" alt="Organize sua rotina">
          <h3>Organize sua rotina</h3>
          <p>
            Organize as atividades na ordem que deseja realizar.
          </p>
        </div>

        <div class="card-etapa etapa-3">
          <span class="numero-etapa numero-3">3</span>
          <img src="/img/website/sobre/check.svg" alt="Complete tarefas">
          <h3>Complete tarefas</h3>
          <p>
            Realize as atividades e marque como concluídas.
          </p>
        </div>

        <div class="card-etapa etapa-4">
          <span class="numero-etapa numero-4">4</span>
          <img src="/img/website/sobre/presente.svg" alt="Ganhe recompensas">
          <h3>Ganhe recompensas</h3>
          <p>
            Acumule pontos e desbloqueie prêmios incríveis!
          </p>
        </div>
      </div>

      <h2 class="titulo-diferenciais">Diferenciais do ConectaMente</h2>

      <div class="cards-diferenciais">
        <div class="card-diferencial">
          <img src="/img/website/sobre/gamepad.svg" alt="Aprendizado gamificado">
          <h3>Aprendizado gamificado</h3>
          <p>
            Transforma o aprendizado em uma experiência divertida.
          </p>
        </div>

        <div class="card-diferencial">
          <img src="/img/website/sobre/cerebro.svg" alt="Desenvolvimento cognitivo">
          <h3>Desenvolvimento cognitivo</h3>
          <p>
            Estimula habilidades importantes para o crescimento infantil.
          </p>
        </div>

        <div class="card-diferencial">
          <img src="/img/website/sobre/calendario.svg" alt="Organização da rotina">
          <h3>Organização da rotina</h3>
          <p>
            Ajuda crianças a criarem hábitos saudáveis e produtivos.
          </p>
        </div>

        <div class="card-diferencial">
          <img src="/img/website/sobre/trofeu.svg" alt="Sistema de recompensas">
          <h3>Sistema de recompensas</h3>
          <p>
            Motiva a criança a superar desafios e alcançar metas.
          </p>
        </div>

        <div class="card-diferencial">
          <img src="/img/website/sobre/apoio.svg" alt="Apoio para pais e educadores">
          <h3>Apoio para pais e educadores</h3>
          <p>
            Relatórios e dicas para acompanhar o progresso da criança.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-sobre-jogo">
    <div class="container">
      <div class="cta-sobre-jogo__box">
        <div class="cta-sobre-jogo__texto">
          <h2>Pronto para começar essa aventura?</h2>
          <p>
            Entre no mundo do ConectaMente e transforme a rotina em diversão e aprendizado!
          </p>
          <a href="/game" class="btn-jogar-sobre">
            Jogar agora
            <img src="/img/website/sobre/controle.svg" alt="Controle">
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>