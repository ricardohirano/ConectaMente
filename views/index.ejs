<%- include("partials/header.ejs") %>
<%- include("partials/navbar.ejs") %>

<main class="home-page">
  <section class="hero-home">
    <div class="hero-home__content">
      <div class="hero-home__text">
        <h1>
          Aprenda organizando sua rotina de forma
          <span>divertida!</span>
        </h1>

        <p>
          O ConectaMente ajuda crianças a desenvolverem responsabilidade,
          organização e autonomia no dia a dia através de desafios e recompensas.
        </p>

        <div class="hero-home__actions">
          <a href="/game" class="btn-home btn-home--primary">Começar agora</a>
          <a href="/sobre" class="btn-home btn-home--link">Saiba mais sobre o jogo</a>
        </div>
      </div>

      <div class="hero-home__image">
        <img src="/img/website/imgGame.svg" alt="Casa com os cômodos do jogo">
      </div>
    </div>
  </section>

  <section class="home-highlights container">
    <div class="home-highlights__card">
      <div class="home-highlights__icon">
        <img src="/img/icone-habilidades.png" alt="Habilidades">
      </div>
      <div>
        <h3>Desenvolve habilidades</h3>
        <p>Estimula a organização e responsabilidade no cotidiano.</p>
      </div>
    </div>

    <div class="home-highlights__card">
      <div class="home-highlights__icon">
        <img src="/img/icone-estrela.png" alt="Aprendizado">
      </div>
      <div>
        <h3>Aprendizado divertido</h3>
        <p>Jogos e desafios tornam o aprendizado leve e prazeroso.</p>
      </div>
    </div>

    <div class="home-highlights__card">
      <div class="home-highlights__icon">
        <img src="/img/icone-seguro.png" alt="Seguro">
      </div>
      <div>
        <h3>Seguro e educativo</h3>
        <p>Conteúdo pensado especialmente para o público infantil.</p>
      </div>
    </div>
  </section>

  <section class="beneficios-home container">
    <div class="section-title">
      <h2>Benefícios do jogo</h2>
      <span></span>
    </div>

    <div class="beneficios-home__grid">
      <div class="beneficio-card">
        <img src="/img/icone-escolhas.png" alt="Escolhas">
        <h3>Escolhas inteligentes</h3>
        <p>Ajuda a criança a tomar decisões no dia a dia.</p>
      </div>

      <div class="beneficio-card">
        <img src="/img/icone-responsabilidade.png" alt="Responsabilidade">
        <h3>Estimula a responsabilidade</h3>
        <p>Incentiva a responsabilidade com suas tarefas.</p>
      </div>

      <div class="beneficio-card">
        <img src="/img/icone-rotina.png" alt="Rotina">
        <h3>Rotina organizada</h3>
        <p>Auxilia na criação de hábitos saudáveis e produtivos.</p>
      </div>

      <div class="beneficio-card">
        <img src="/img/icone-recompensa.png" alt="Recompensas">
        <h3>Recompensas motivadoras</h3>
        <p>Sistema de pontos e recompensas que incentiva o esforço.</p>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer.ejs") %>