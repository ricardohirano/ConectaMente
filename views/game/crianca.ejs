<%- include('partials/headerGame') %>

<main class="pagina-acesso-game">
  <a href="/game" class="btn-voltar-site" aria-label="Sair da conta">
    <img src="/img/game/voltar.svg" alt="Sair da conta">
  </a>

  <section class="painel-crianca">
    <div class="topo-crianca">
      <img src="/img/website/index/logoConectamente.svg" alt="ConectaMente" class="logo-crianca">

      <div class="avatar-topo-crianca">
        <img src="/img/game/avatars/<%= crianca?.avatar || 'personagem1.svg' %>" alt="Avatar da criança">
      </div>
    </div>

    <h1 class="saudacao-crianca">Olá, <%= usuario.nome %></h1>

      <a href="/game/escolha-personagem/<%= usuario.id %>?origem=novo-jogo" class="card-menu-crianca" id="btnNovoJogo">
      <div class="icone-menu-crianca icone-cinza">
        <img src="/img/game/mais.svg" alt="Novo jogo">
      </div>

      <div class="texto-menu-crianca">Novo Jogo</div>

      <div class="seta-menu-crianca">
        <img src="/img/game/seta-direita.svg" alt="Abrir">
      </div>
    </a>

    <% if (temNovoJogoCriado) { %>
      <a href="/game/perfil/<%= usuario.id %>" class="card-menu-crianca">
        <div class="icone-menu-crianca icone-azul">
          <img src="/img/game/icone-usuario.svg" alt="Perfil">
        </div>

        <div class="texto-menu-crianca">Perfil</div>

        <div class="seta-menu-crianca">
          <img src="/img/game/seta-direita.svg" alt="Abrir">
        </div>
      </a>
    <% } %>

    <% if (temJogoSalvo) { %>
      <a href="/game/jogos-salvos/<%= usuario.id %>" class="card-menu-crianca">
        <div class="icone-menu-crianca icone-azul">
          <img src="/img/game/carregar.svg" alt="Carregar jogo">
        </div>

        <div class="texto-menu-crianca">Carregar Jogo</div>

        <div class="seta-menu-crianca">
          <img src="/img/game/seta-direita.svg" alt="Abrir">
        </div>
      </a>
    <% } %>
  </section>
  <script>
    const btnNovoJogo = document.getElementById("btnNovoJogo");
  
    if (btnNovoJogo) {
      btnNovoJogo.addEventListener("click", () => {
        localStorage.removeItem("saveAtualConectaMente");
      });
    }
  </script>
</main>

</body>
</html>