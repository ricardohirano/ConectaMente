<%- include('../partials/headerFase') %>

<script>
  const dadosFase = <%- JSON.stringify(fase) %>;
</script>

<main class="pagina-fase-game">
  <%- include('../partials/navbarFase') %>

  <section class="painel-fase">
    <div class="cenario-fase">
      <img
        src="<%= fase.imagem_fundo %>"
        alt="Fundo da fase"
        class="imagem-cenario"
      >

      <div class="conquista-fase">
        <span class="conquista-titulo">Conquista</span>

        <div class="conquista-info">
          <img src="/img/game/apoio/estrela.svg" alt="Estrela">
          <span id="contadorConquista">0</span>
        </div>
      </div>

      <% fase.acoes.forEach(function(acao) { %>
        <button
          type="button"
          class="objeto-interativo objeto-acao"
          data-slug="<%= acao.slug %>"
          style="
            left: <%= acao.posicao_left %>;
            top: <%= acao.posicao_top %>;
            width: <%= acao.largura %>;
            <%= acao.altura ? `height: ${acao.altura};` : '' %>
          "
        >
          <img
            src="<%= acao.imagem_antes %>"
            alt="<%= acao.nome %>"
            id="img-<%= acao.slug %>"
          >
        </button>
      <% }) %>

      <div class="avatar-fase">
        <img
          src="/img/game/avatars/<%= crianca?.avatar || 'personagem1.svg' %>"
          alt="Personagem"
        >
      </div>

      <% if (dificuldade === "facil" || dificuldade === "medio") { %>
        <% fase.acoes.forEach(function(acao, index) { %>
          <div
            class="estrela-acao"
            id="estrela-<%= acao.slug %>"
            style="
              left: <%= acao.estrela_left %>;
              top: <%= acao.estrela_top %>;
            "
          >
            <% if (dificuldade === "facil") { %>
              <img src="/img/game/apoio/estrela<%= index + 1 %>.svg" alt="Estrela <%= index + 1 %>">
            <% } else { %>
              <img src="/img/game/apoio/estrela.svg" alt="Estrela">
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </section>

  <!-- MODAL QUIZ -->
  <div class="modal-quiz" id="modalQuiz">
    <div class="modal-quiz__caixa">
      <h2 id="tituloQuiz">Qual é a ação correta?</h2>

      <div class="opcoes-quiz" id="opcoesQuiz"></div>

      <button type="button" class="btn-fechar-quiz" id="fecharQuiz">
        Fechar
      </button>
    </div>
  </div>

  <!-- MODAL PARABÉNS -->
  <div class="modal-parabens" id="modalParabens">
    <div class="modal-parabens__caixa">
      <h2>Parabéns!</h2>
      <p id="textoParabens">Você completou a ação corretamente.</p>

      <button type="button" id="fecharParabens">
        Continuar
      </button>
    </div>
  </div>

  <!-- MODAL ERRO -->
  <div class="modal-erro" id="modalErro">
    <div class="modal-erro__caixa">
      <h2>Ops!</h2>
      <p id="textoErroOrdem">Tem algo para fazer antes, tente novamente.</p>

      <button type="button" id="fecharErro">
        Entendi
      </button>
    </div>
  </div>

  <!-- MODAL FASE CONCLUÍDA -->
  <div class="modal-fase-concluida" id="modalFaseConcluida">
    <div class="modal-fase-concluida__caixa">
      <h2>Fase Concluída!</h2>
      <p>Você completou todas as ações do quarto.</p>

      <div class="acoes-fase-concluida">
        <a href="/game/perfil/<%= usuario.id %>" class="btn-fase-concluida">
          Voltar ao Perfil
        </a>

        <% if (dificuldade === "facil") { %>
          <a href="/game/fase/<%= usuario.id %>/quarto/medio" class="btn-fase-concluida destaque">
            Aumentar Dificuldade
          </a>
        <% } else if (dificuldade === "medio") { %>
          <a href="/game/fase/<%= usuario.id %>/quarto/dificil" class="btn-fase-concluida destaque">
            Aumentar Dificuldade
          </a>
        <% } else { %>
          <a href="/game/perfil/<%= usuario.id %>" class="btn-fase-concluida destaque">
            Finalizar
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- MODAL SALVAR -->
  <div class="modal-salvar" id="modalSalvar">
    <div class="modal-salvar__caixa">
      <h2>Salvar jogo</h2>
      <p>Deseja salvar seu progresso atual?</p>

      <div class="acoes-fase-concluida">
        <button type="button" class="btn-fase-concluida" id="cancelarSalvar">
          Cancelar
        </button>

        <button type="button" class="btn-fase-concluida destaque" id="confirmarSalvar">
          Salvar agora
        </button>
      </div>
    </div>
  </div>
</main>

<script>
  const modalQuiz = document.getElementById("modalQuiz");
  const fecharQuiz = document.getElementById("fecharQuiz");

  const modalParabens = document.getElementById("modalParabens");
  const fecharParabens = document.getElementById("fecharParabens");

  const modalErro = document.getElementById("modalErro");
  const fecharErro = document.getElementById("fecharErro");
  const textoErroOrdem = document.getElementById("textoErroOrdem");

  const modalFaseConcluida = document.getElementById("modalFaseConcluida");

  const tituloQuiz = document.getElementById("tituloQuiz");
  const textoParabens = document.getElementById("textoParabens");
  const opcoesQuiz = document.getElementById("opcoesQuiz");

  const contadorConquista = document.getElementById("contadorConquista");

  const btnSalvarJogo = document.getElementById("btnSalvarJogo");
  const modalSalvar = document.getElementById("modalSalvar");
  const cancelarSalvar = document.getElementById("cancelarSalvar");
  const confirmarSalvar = document.getElementById("confirmarSalvar");

  const botoesAcoes = document.querySelectorAll(".objeto-acao");

  const acoesDaFase = [...dadosFase.acoes].sort((a, b) => a.ordem_acao - b.ordem_acao);
  const ordemCorreta = acoesDaFase.map(acao => acao.slug);

  const estadoAcoes = {};
  ordemCorreta.forEach(slug => {
    estadoAcoes[slug] = false;
  });

  let acaoAtual = null;
  let totalConquista = 0;

  let tentativasTotal = 0;
  let errosResposta = 0;
  let errosOrdem = 0;
  let acoesConcluidas = 0;
  let faseJaSalva = false;

  function valorPorAcerto() {
    const dificuldadeAtual = String("<%= dificuldade %>")
      .trim()
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");

    if (dificuldadeAtual === "facil") return 1;
    if (dificuldadeAtual === "medio") return 2;
    if (dificuldadeAtual === "dificil") return 3;

    return 1;
  }

  function buscarAcao(slugAcao) {
    return acoesDaFase.find(acao => acao.slug === slugAcao);
  }

  function proximaAcaoEsperada() {
    return ordemCorreta.find(slug => !estadoAcoes[slug]);
  }

  function abrirModalErro(mensagem) {
    textoErroOrdem.textContent = mensagem;
    modalErro.classList.add("ativo");
  }

  function embaralharArray(array) {
    const copia = [...array];

    for (let i = copia.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copia[i], copia[j]] = [copia[j], copia[i]];
    }

    return copia;
  }

  function renderizarOpcoes(opcoes) {
    opcoesQuiz.innerHTML = "";

    const opcoesEmbaralhadas = embaralharArray(opcoes);
    const classesCores = [
      "opcao-quiz--azul",
      "opcao-quiz--verde",
      "opcao-quiz--rosa",
      "opcao-quiz--laranja"
    ];

    opcoesEmbaralhadas.forEach((opcao, index) => {
      const botao = document.createElement("button");
      botao.type = "button";
      botao.className = `opcao-quiz ${classesCores[index]}`;
      botao.textContent = opcao.texto_opcao;

      botao.addEventListener("click", () => {
        if (opcao.correta) {
          concluirAcao(acaoAtual);
        } else {
          errosResposta++;
          abrirModalErro("Resposta incorreta. Tente novamente.");
        }
      });

      opcoesQuiz.appendChild(botao);
    });
  }

  function abrirQuiz(slugAcao) {
    if (estadoAcoes[slugAcao]) {
      return;
    }

    const esperada = proximaAcaoEsperada();

    if (slugAcao !== esperada) {
      errosOrdem++;
      tentativasTotal++;
      abrirModalErro("Tem algo para fazer antes, tente novamente.");
      return;
    }

    const acao = buscarAcao(slugAcao);
    if (!acao) return;

    tentativasTotal++;
    acaoAtual = slugAcao;

    tituloQuiz.textContent = acao.pergunta;
    textoParabens.textContent = acao.mensagem_acerto;

    renderizarOpcoes(acao.opcoes_resposta || []);
    modalQuiz.classList.add("ativo");
  }

  function atualizarImagemAcao(slugAcao) {
    const acao = buscarAcao(slugAcao);
    const img = document.getElementById(`img-${slugAcao}`);

    if (acao && img) {
      img.src = acao.imagem_depois;
    }
  }

  function esconderEstrelaAcao(slugAcao) {
    const estrela = document.getElementById(`estrela-${slugAcao}`);
    if (estrela) {
      estrela.style.display = "none";
    }
  }

  async function salvarConclusaoFase() {
    if (faseJaSalva) return;

    try {
      const resposta = await fetch("/game/concluir-fase/<%= usuario.id %>/<%= fase.slug %>/<%= dificuldade %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          tentativas_total: tentativasTotal,
          erros_resposta: errosResposta,
          erros_ordem: errosOrdem,
          acoes_concluidas: acoesConcluidas,
          estrelas_ganhas: totalConquista
        })
      });

      const resultado = await resposta.json();

      if (resultado.sucesso) {
        faseJaSalva = true;
      } else {
        console.log("Não foi possível salvar a conclusão da fase:", resultado.mensagem);
      }
    } catch (error) {
      console.log("Erro ao salvar conclusão da fase:", error);
    }
  }

  async function concluirAcao(slugAcao) {
    estadoAcoes[slugAcao] = true;
    acoesConcluidas++;

    totalConquista += valorPorAcerto();
    contadorConquista.textContent = totalConquista;

    modalQuiz.classList.remove("ativo");

    atualizarImagemAcao(slugAcao);
    esconderEstrelaAcao(slugAcao);

    const todasConcluidas = ordemCorreta.every(slug => estadoAcoes[slug]);

    if (todasConcluidas) {
      await salvarConclusaoFase();
      modalFaseConcluida.classList.add("ativo");
    } else {
      modalParabens.classList.add("ativo");
    }
  }

  botoesAcoes.forEach(botao => {
    botao.addEventListener("click", () => {
      const slugAcao = botao.dataset.slug;
      abrirQuiz(slugAcao);
    });
  });

  if (fecharQuiz) {
    fecharQuiz.addEventListener("click", () => {
      modalQuiz.classList.remove("ativo");
    });
  }

  if (modalQuiz) {
    modalQuiz.addEventListener("click", (event) => {
      if (event.target === modalQuiz) {
        modalQuiz.classList.remove("ativo");
      }
    });
  }

  if (fecharParabens) {
    fecharParabens.addEventListener("click", () => {
      modalParabens.classList.remove("ativo");
    });
  }

  if (modalParabens) {
    modalParabens.addEventListener("click", (event) => {
      if (event.target === modalParabens) {
        modalParabens.classList.remove("ativo");
      }
    });
  }

  if (fecharErro) {
    fecharErro.addEventListener("click", () => {
      modalErro.classList.remove("ativo");
    });
  }

  if (modalErro) {
    modalErro.addEventListener("click", (event) => {
      if (event.target === modalErro) {
        modalErro.classList.remove("ativo");
      }
    });
  }

  if (btnSalvarJogo && modalSalvar) {
    btnSalvarJogo.addEventListener("click", () => {
      modalSalvar.classList.add("ativo");
    });
  }

  if (cancelarSalvar && modalSalvar) {
    cancelarSalvar.addEventListener("click", () => {
      modalSalvar.classList.remove("ativo");
    });
  }

  if (modalSalvar) {
    modalSalvar.addEventListener("click", (event) => {
      if (event.target === modalSalvar) {
        modalSalvar.classList.remove("ativo");
      }
    });
  }

  if (confirmarSalvar) {
    confirmarSalvar.addEventListener("click", () => {
      const dadosSaveAtual = {
        nomeSessao: "Jogo <%= fase.nome %>",
        slugFase: "<%= fase.slug %>",
        dificuldade: "<%= dificuldade %>",
        acaoAtual: typeof proximaAcaoEsperada === "function"
          ? (proximaAcaoEsperada() || "concluida")
          : "concluida",
        estrelasAcumuladas: typeof totalConquista !== "undefined" ? totalConquista : 0,
        dadosEstado: typeof estadoAcoes !== "undefined" ? estadoAcoes : {}
      };

      localStorage.setItem("saveAtualConectaMente", JSON.stringify(dadosSaveAtual));

      if (modalSalvar) {
        modalSalvar.classList.remove("ativo");
      }

      window.location.href = `/game/escolher-save/<%= usuario.id %>/<%= fase.slug %>/<%= dificuldade %>`;
    });
  }
</script>

</body>
</html>