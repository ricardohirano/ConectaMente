<%- include('partials/headerGame') %>

<main class="pagina-acesso-game">
  <a href="/" class="btn-voltar-site" aria-label="Voltar para o site">
    <img src="/img/game/voltar.svg" alt="Voltar">
  </a>

  <div class="login-box">
    <div class="logo-login">
      <img src="/img/website/index/logoConectamente.svg" alt="ConectaMente">
    </div>

    <h1 class="titulo-login">Login</h1>

    <% const erro = query?.erro; %>

    <% if (erro === "email_nao_cadastrado") { %>
      <p class="mensagem-erro">E-mail não cadastrado.</p>
    <% } %>

    <% if (erro === "senha_incorreta") { %>
      <p class="mensagem-erro">Senha incorreta.</p>
    <% } %>

    <% if (erro === "ativacao_responsavel") { %>
      <p class="mensagem-erro">Essa conta infantil precisa ser ativada por um responsável.</p>
    <% } %>

    <% if (erro === "criar_responsavel") { %>
      <p class="mensagem-erro">Não existe conta responsável cadastrada. Crie uma conta responsável para ativar esta conta infantil.</p>
    <% } %>

    <% if (erro === "servidor") { %>
      <p class="mensagem-erro">Ocorreu um erro interno. Tente novamente.</p>
    <% } %>
    <% if (typeof limiteAtingido !== "undefined" && limiteAtingido) { %>
      <div class="alerta-limite-jogo">
        O tempo de uso desta conta terminou. Faça login novamente depois.
      </div>
    <% } %>
    <form class="form-login" action="/usuarios/login" method="POST">
      <div class="campo-login">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" placeholder="Digite seu e-mail" required>
      </div>

      <div class="campo-login">
        <label for="senha">Senha</label>
        <input type="password" id="senha" name="senha" placeholder="Digite sua senha" required>
      </div>

      <a href="#" class="link-esqueceu">Esqueceu a senha?</a>

      <button type="submit" class="btn-entrar">Entrar</button>

      <p class="link-cadastro">
        Não tem uma conta?
        <a href="/game/criar-conta">Criar conta</a>
      </p>
    </form>
  </div>
</main>

</body>
</html>