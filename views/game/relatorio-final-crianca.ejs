<%- include('partials/headerGame') %>
<%
  const avatarBase = crianca && crianca.avatar ? crianca.avatar : "personagem1";

  let avatarPequeno = "/img/game/avatars/perfil1.svg";

  if (avatarBase === "personagem1") {
    avatarPequeno = "/img/game/avatars/perfil1.svg";
  }

  if (avatarBase === "personagem2") {
    avatarPequeno = "/img/game/avatars/perfil2.svg";
  }

  if (avatarBase === "personagem3") {
    avatarPequeno = "/img/game/avatars/perfil3.png";
  }

  if (avatarBase === "personagem4") {
    avatarPequeno = "/img/game/avatars/perfil4.png";
  }
%>
<main class="pagina-acesso-game">
  <a href="/game/rendimento-crianca/<%= usuario.id %>/<%= idResponsavel %>" class="btn-voltar-site" aria-label="Voltar">
    <img src="/img/game/voltar.svg" alt="Voltar">
  </a>

  <section class="painel-relatorio-final">
    <h1 class="titulo-relatorio-final">Relatório</h1>

    <div class="bloco-relatorio-final">
      <div class="coluna-relatorio-esquerda">
        <div class="topo-identificacao-relatorio">
          <div class="avatar-relatorio-final">
            <img src="<%= avatarPequeno %>" alt="Avatar">
          </div>

          <div class="dados-topo-relatorio">
            <h2><%= usuario.nome %></h2>

            <a href="/game/relatorio-final-pdf/<%= usuario.id %>/<%= idResponsavel %>" class="btn-gerar-pdf" target="_blank">
              Gerar relatório em PDF
            </a>
          </div>
        </div>

        <div class="card-resumo-progresso-final">
          <h2>Resumo do progresso</h2>

          <div class="indicadores-relatorio-final">
            <div class="indicador-relatorio-final">
              <div class="box-indicador-relatorio estrela">
                <span><%= totalEstrelas %></span>
              </div>
              <p>Estrelas coletadas</p>
            </div>

            <div class="indicador-relatorio-final">
              <div class="box-indicador-relatorio">
                <span><%= percentualAcerto %>%</span>
              </div>
              <p>Média de acertos</p>
            </div>

            <div class="indicador-relatorio-final">
              <div class="box-indicador-relatorio">
                <span><%= mediaTempo %></span>
              </div>
              <p>Tempo médio de jogo (min)</p>
            </div>
          </div>

          <div class="grafico-resumo-final-box">
            <canvas id="graficoResumoFinal"></canvas>
          </div>
        </div>
      </div>

      <div class="coluna-relatorio-direita">
        <div class="cabecalho-tabela-relatorio">
          <span>Módulo</span>
          <span>Última modificação</span>
          <span>Status / dificuldade</span>
        </div>

        <div class="corpo-tabela-relatorio">
          <% statusFases.forEach(function(item) { %>
            <div class="linha-tabela-relatorio">
              <div class="celula-modulo"><%= item.nome %></div>
              <div class="celula-data"><%= item.data %></div>
              <div class="celula-status">
                <% if (item.status === "concluido") { %>
                  <span class="status-relatorio status-concluido">
                    ✓ concluído <%= item.dificuldade ? '(' + item.dificuldade + ')' : '' %>
                  </span>
                <% } else if (item.status === "em_andamento") { %>
                  <span class="status-relatorio status-andamento">
                    ● em andamento
                  </span>
                <% } else { %>
                  <span class="status-relatorio status-nao-comecou">
                    ● não começou
                  </span>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const ctxResumoFinal = document.getElementById("graficoResumoFinal");

  const labelsResumoFinal = <%- JSON.stringify(progressoLabels) %>;
  const valoresResumoFinal = <%- JSON.stringify(progressoValores) %>;

  new Chart(ctxResumoFinal, {
    type: "line",
    data: {
      labels: labelsResumoFinal,
      datasets: [{
        data: valoresResumoFinal,
        borderColor: "#0D63D8",
        backgroundColor: "#0D63D8",
        pointBackgroundColor: "#F2B900",
        pointBorderColor: "#F2B900",
        pointRadius: 4,
        pointHoverRadius: 5,
        tension: 0.35,
        fill: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        }
      },
      scales: {
        x: {
          grid: {
            display: false
          },
          ticks: {
            color: "#0D63D8",
            font: {
              size: 12,
              weight: "700"
            }
          },
          border: {
            color: "#0D63D8",
            width: 3
          }
        },
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1,
            color: "#0D63D8",
            font: {
              size: 12,
              weight: "700"
            }
          },
          grid: {
            color: "rgba(13, 99, 216, 0.10)"
          },
          border: {
            display: false
          }
        }
      }
    }
  });
</script>

</body>
</html>