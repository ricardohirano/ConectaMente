<%- include('partials/headerGame') %>

<%
  const avatarBase = conta && conta.avatar ? conta.avatar : "personagem1";

  let avatarPequeno = "/img/game/avatars/perfil1.svg";

  if (avatarBase === "personagem1") {
    avatarPequeno = "/img/game/avatars/perfil1.svg";
  }

  if (avatarBase === "personagem2") {
    avatarPequeno = "/img/game/avatars/perfil2.svg";
  }

  if (avatarBase === "personagem3") {
    avatarPequeno = "/img/game/avatars/perfil3.png";
  }

  if (avatarBase === "personagem4") {
    avatarPequeno = "/img/game/avatars/perfil4.png";
  }
%>

<main class="pagina-acesso-game">
  <a href="/game/contas-acessiveis/<%= idResponsavel %>" class="btn-voltar-site" aria-label="Voltar">
    <img src="/img/game/voltar.svg" alt="Voltar">
  </a>

  <section class="painel-contas">
    <img src="/img/website/index/logoConectamente.svg" alt="ConectaMente" class="logo-painel">

    <div class="bloco-contas">
      <div class="topo-contas centralizado">
        <h1>Conta</h1>
      </div>

      <% if (conta) { %>
        <div class="card-conta card-conta-admin">
          <div class="avatar-conta">
            <img src="<%= avatarPequeno %>" alt="Avatar">
          </div>

          <div class="info-conta">
            <h2><%= conta.nome %></h2>
            <p><%= conta.email %></p>

            <p class="texto-limite">
              <strong>Limite atual:</strong>
              <% if (Number(conta.limite_tempo_diario) === 0) { %>
                Sem limites
              <% } else { %>
                <%= conta.limite_tempo_diario %> minutos
              <% } %>
            </p>
          </div>

          <div class="acoes-admin-conta">
            <button type="button" class="btn-admin azul" id="abrirModalTempo">
              Limite de tempo por dia
            </button>

            <% if (conta.permissao_ativa) { %>
              <a href="/game/desativar-conta/<%= conta.id %>/<%= idResponsavel %>" class="btn-admin azul btn-admin-link">
                Desativar Conta
              </a>
            <% } else { %>
              <a href="/game/ativar-conta/<%= conta.id %>/<%= idResponsavel %>" class="btn-admin azul btn-admin-link">
                Ativar Conta
              </a>
            <% } %>

            <button
              type="button"
              class="btn-admin azul"
              onclick="window.location.href='/game/rendimento-crianca/<%= conta.id %>/<%= idResponsavel %>'"
            >
              Rendimento da criança
            </button>

            <button type="button" class="btn-admin vermelho" id="abrirModalExcluir">
              Excluir Conta
            </button>
          </div>
        </div>

        <div class="modal-excluir" id="modalTempo">
          <div class="modal-excluir__caixa modal-tempo">
            <h2>Essa conta será limitada a quanto<br>tempo de jogo por dia? (Em Minutos)</h2>

            <div class="modal-tempo__acoes">
              <form action="/game/limite-tempo/<%= conta.id %>/<%= idResponsavel %>" method="POST">
                <input type="hidden" name="limite" value="1">
                <button type="submit" class="btn-modal azul">1 Minuto</button>
              </form>

              <form action="/game/limite-tempo/<%= conta.id %>/<%= idResponsavel %>" method="POST">
                <input type="hidden" name="limite" value="5">
                <button type="submit" class="btn-modal azul">5 Minutos</button>
              </form>

              <form action="/game/limite-tempo/<%= conta.id %>/<%= idResponsavel %>" method="POST">
                <input type="hidden" name="limite" value="0">
                <button type="submit" class="btn-modal azul">Sem Limites</button>
              </form>
            </div>

            <button type="button" class="btn-fechar-modal" id="fecharModalTempo">Fechar</button>
          </div>
        </div>

        <div class="modal-excluir" id="modalExcluir">
          <div class="modal-excluir__caixa">
            <h2>Você tem certeza que<br>quer excluir essa conta?</h2>

            <div class="modal-excluir__acoes">
              <button type="button" class="btn-modal nao" id="fecharModalExcluir">NÃO</button>

              <form action="/game/excluir-conta/<%= conta.id %>/<%= idResponsavel %>" method="POST">
                <button type="submit" class="btn-modal sim">SIM</button>
              </form>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="contas-vazias">
          <p>Conta não encontrada.</p>
        </div>
      <% } %>
    </div>
  </section>
</main>

<script>
  const modalExcluir = document.getElementById("modalExcluir");
  const abrirModalExcluir = document.getElementById("abrirModalExcluir");
  const fecharModalExcluir = document.getElementById("fecharModalExcluir");

  if (abrirModalExcluir) {
    abrirModalExcluir.addEventListener("click", function () {
      modalExcluir.classList.add("ativo");
    });
  }

  if (fecharModalExcluir) {
    fecharModalExcluir.addEventListener("click", function () {
      modalExcluir.classList.remove("ativo");
    });
  }

  if (modalExcluir) {
    modalExcluir.addEventListener("click", function (event) {
      if (event.target === modalExcluir) {
        modalExcluir.classList.remove("ativo");
      }
    });
  }

  const modalTempo = document.getElementById("modalTempo");
  const abrirModalTempo = document.getElementById("abrirModalTempo");
  const fecharModalTempo = document.getElementById("fecharModalTempo");

  if (abrirModalTempo) {
    abrirModalTempo.addEventListener("click", function () {
      modalTempo.classList.add("ativo");
    });
  }

  if (fecharModalTempo) {
    fecharModalTempo.addEventListener("click", function () {
      modalTempo.classList.remove("ativo");
    });
  }

  if (modalTempo) {
    modalTempo.addEventListener("click", function (event) {
      if (event.target === modalTempo) {
        modalTempo.classList.remove("ativo");
      }
    });
  }
</script>

</body>
</html>