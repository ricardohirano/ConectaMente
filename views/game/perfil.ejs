<%- include('partials/headerGame') %>

<main class="pagina-acesso-game">
  <a href="/game/crianca/<%= usuario.id %>" class="btn-voltar-site" aria-label="Voltar">
    <img src="/img/game/voltar.svg" alt="Voltar">
  </a>

  <section class="painel-perfil-crianca">
    <div class="topo-perfil-crianca">
      <img src="/img/website/logo-conectamente.png" alt="ConectaMente" class="logo-perfil-crianca">
    </div>

    <div class="cabecalho-perfil-crianca">
      <div class="lado-esquerdo-perfil">
        <div class="bloco-identidade-crianca">
          <div class="avatar-perfil-crianca">
            <img src="/img/game/<%= crianca?.avatar || 'avatar-menino' %>.png" alt="Avatar">
          </div>

          <div class="info-perfil-crianca">
            <div class="nome-avatar-box">
              <h1><%= crianca?.nome_avatar || usuario.nome %></h1>
            </div>

            <button type="button" class="btn-editar-avatar">Editar</button>
          </div>
        </div>

        <div class="linha-botoes-perfil">
          <a href="/game/jogos-salvos/<%= usuario.id %>" class="btn-perfil-acao">
            JOGOS SALVOS
          </a>

          <button type="button" class="btn-perfil-acao">
            SALVAR ALTERAÇÕES
          </button>

          <a href="/game" class="btn-perfil-acao">
            SAIR DA CONTA
          </a>
        </div>
      </div>

      <div class="lado-direito-perfil">
        <div class="card-avatar-lateral">
          <img src="/img/game/<%= crianca?.avatar || 'avatar-menino' %>.png" alt="Avatar grande">
          <a href="/game/escolha-personagem/<%= usuario.id %>" class="btn-trocar-avatar">TROCAR</a>
        </div>
      </div>
    </div>

    <div class="bloco-progresso-visual">
      <div class="box-estrelas">
        <div class="icone-estrela-box">
          <img src="/img/game/estrela.svg" alt="Estrela">
        </div>

        <div class="conteudo-estrelas-box">
          <h2>Suas Estrelas</h2>
          <span class="valor-estrelas"><%= totalEstrelas %></span>
        </div>
      </div>

      <div class="box-fases">
        <% progressoFases.forEach(function(fase) { %>
          <div class="card-fase-perfil <%= !fase.liberado ? 'bloqueada' : '' %>">
            <div class="icone-fase-perfil">
              <img src="/img/game/<%= fase.icone %>" alt="<%= fase.comodo %>">
            </div>

            <div class="nome-fase-perfil <%= fase.concluidoTotal ? 'concluida' : '' %>">
              <%= fase.comodo %>
            </div>

            <div class="dificuldades-fase-perfil">
              <% if (fase.liberado) { %>
                <a href="/game/fase/<%= usuario.id %>/<%= fase.slug %>/facil"
                   class="tag-dificuldade-botao <%= fase.facil ? 'concluida' : '' %>">
                  Fácil
                </a>

                <a href="/game/fase/<%= usuario.id %>/<%= fase.slug %>/medio"
                   class="tag-dificuldade-botao <%= fase.medio ? 'concluida' : '' %>">
                  Médio
                </a>

                <a href="/game/fase/<%= usuario.id %>/<%= fase.slug %>/dificil"
                   class="tag-dificuldade-botao <%= fase.dificil ? 'concluida' : '' %>">
                  Difícil
                </a>
              <% } else { %>
                <span class="tag-dificuldade-botao bloqueado">Fácil</span>
                <span class="tag-dificuldade-botao bloqueado">Médio</span>
                <span class="tag-dificuldade-botao bloqueado">Difícil</span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>
</main>

</body>
</html>